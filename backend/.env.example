# ==============================================================================
# FRAME AI - Backend Environment Configuration Template
# Copy this file to .env and configure your secrets:
#   copy .env.example .env
# NEVER commit the .env file to Git!
# ==============================================================================

# 1. Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=replace_with_your_key

# 2. Gemini Model to use (e.g. gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# 3. Allowed Frontend Origins for CORS (comma-separated list or single URL)
# For local development: http://localhost:5500, http://127.0.0.1:5500, http://localhost:8000
# For GitHub Pages production: https://<your-username>.github.io
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# 4. Rate Limiting (Maximum requests allowed per client IP per minute)
RATE_LIMIT_PER_MINUTE=20

# 5. Request Timeout in Seconds
REQUEST_TIMEOUT_SECONDS=20

# 6. Server Port (Render sets this dynamically via $PORT)
PORT=8000
